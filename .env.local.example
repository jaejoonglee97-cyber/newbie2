# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
# .env.local 은 .gitignore 에 포함되어 있으므로 커밋되지 않는다.
# 실제 키를 이 예시 파일에 직접 적지 않는다.

# ---------------------------------------------------------------------------
# 데이터 원본
# ---------------------------------------------------------------------------
# mock   : 가상 데이터. 서비스 계정 없이 화면과 접수 흐름을 검증할 때 쓴다.
# sheets : 실제 Google Sheets. 아래 3개 값이 모두 있어야 한다.
#
# 비워 두면 아래 3개 값의 존재 여부로 자동 판정한다.
NEWBIE_DATA_SOURCE=mock

# ---------------------------------------------------------------------------
# Google Sheets 연결 (서버 전용)
# ---------------------------------------------------------------------------
# 브라우저로 절대 내려가지 않는 값이다. NEXT_PUBLIC_ 접두어를 붙이지 않는다.

# 서비스 계정 이메일. 예: newbie-alumni@my-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# 서비스 계정 개인키. JSON 키 파일의 private_key 값을 그대로 넣는다.
# 줄바꿈이 \n 문자열로 들어가도 코드에서 변환한다. 전체를 큰따옴표로 감싼다.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 대상 스프레드시트 ID. 시트 URL 의 /d/ 와 /edit 사이 문자열이다.
SHEETS_SPREADSHEET_ID=

# ---------------------------------------------------------------------------
# 명함 업로드 중계 (Apps Script Web App)
# ---------------------------------------------------------------------------
# setup/card-upload.gs 배포 후 나오는 값을 넣는다.
# 비워 두면 명함 업로드만 비활성화되고 신청 접수는 정상 동작한다.

APPS_SCRIPT_UPLOAD_URL=
APPS_SCRIPT_UPLOAD_SECRET=

# ---------------------------------------------------------------------------
# 공동 비밀번호 로그인
# ---------------------------------------------------------------------------
# 참여자와 운영자가 같은 비밀번호를 쓰면 안 된다. 운영자 비밀번호가 우선 판정되므로
# 두 값이 같으면 참여자도 운영자 권한으로 로그인된다.

ALUMNI_PASSWORD=
ADMIN_PASSWORD=

# 세션 쿠키 서명에 쓰는 무작위 문자열. 32자 이상 권장.
# 아래 명령으로 만들 수 있다: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 이 값을 바꾸면 로그인해 있던 모든 사용자의 세션이 무효화된다.
SESSION_SECRET=
